#!/usr/bin/env bash
# codex-yolo — Launch parallel OpenAI Codex CLI agents with auto-approval via tmux
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

SESSION_NAME=""
AUDIT_LOG=""
CODEX_YOLO_TMUX_SOCKET=""

usage() {
    cat <<'EOF'
Usage: codex-yolo [options] ["task one" "task two" ...]

Launch parallel OpenAI Codex CLI agents in tmux with auto-approval.

Options:
  Default Codex permissions: Ask for approval (workspace-write, on-request, user review)
  Command network access: enabled inside the workspace-write sandbox
  -s, --session NAME    Custom tmux session name (default: codex-yolo-<timestamp>)
  -d, --dir PATH        Working directory for agents (default: current directory)
  -m, --model MODEL     Model to use (e.g., gpt-6-astra, gpt-5.6-sol).
                        Default: best available model, probed automatically
                        (Astra → Sol → Terra → Luna → GPT-5.5), cached for 24h
  -e, --effort LEVEL    Reasoning effort for each agent
                        (minimal|low|medium|high|xhigh|max|ultra, or 'none' to
                        leave Codex's configured default). Default: ultra;
                        compatibility fallbacks: Luna max, GPT-5.5 xhigh
  -p, --poll SECONDS    Approver poll interval (default: 0.3)
  -f, --file FILE       Read a multiline prompt from a text file
  -c, --command STRING  Slash command to run in the control pane after launch
                        (e.g. "/loop 10m /plan ...", "/queue [...]", "/help").
                        Must start with '/'. Multi-line strings are sent as a paste.
                        Compose multiple commands via /queue rather than repeating -c.
                        Works with --resume to inject into an existing session.
  -r, --resume          Re-attach to an existing yolo session
  --permissions PROFILE Set Codex permissions mode (default: ask-for-approval)
  --network             Enable command network access (default)
  --no-network          Disable command network access
  --no-codex-sandbox    Disable Codex sandboxing (for externally sandboxed containers)
  --force-codex-sandbox Require Codex sandboxing; do not auto-fallback when unsupported
  -h, --help            Show this help

Worktree options:
  -w, --worktree          Run each agent in its own git worktree
  --base-branch BRANCH    Base branch for worktrees (default: current branch)
  --no-merge              Skip auto-merge after agents complete
  --no-cleanup            Keep worktrees after merge
  --conflict-poll SECS    Conflict detection interval (default: 5)

Examples:
  codex-yolo                     # interactive codex with auto-approval
  codex-yolo "fix the login bug" "add unit tests for auth"
  codex-yolo --model o4-mini --dir /my/project "refactor the API layer"
  codex-yolo --file prompt.txt
  codex-yolo --resume
  codex-yolo -c "/loop 10m /plan Draft the next implementation plan"
  codex-yolo -c '/queue ["/plan first", "/loop 1h /plan continue"]'
  codex-yolo --resume -c "/loops"
  codex-yolo -w -s feat -d /repo "add auth" "add tests" "add docs"
EOF
}

# Print the process and each of its ancestors, stopping safely at init.
codex_yolo_process_ancestors() {
    local pid="${1:-$BASHPID}"
    local parent_pid seen=" "

    while [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 1 )); do
        [[ "$seen" != *" $pid "* ]] || break
        printf '%s\n' "$pid"
        seen+="$pid "

        parent_pid="$(ps -o ppid= -p "$pid" 2>/dev/null)" || break
        parent_pid="${parent_pid//[[:space:]]/}"
        pid="$parent_pid"
    done
}

# Resolve the socket of the tmux server that owns the invoking shell. Mobile
# SSH and other control-mode clients can leave a stale/default TMUX value after
# moving a terminal between `tmux -L` servers. The owning tmux server remains
# in the shell's process ancestry, so validate TMUX against that PID and scan
# sibling sockets only when it does not match.
codex_yolo_detect_tmux_socket() {
    local start_pid="${1:-$BASHPID}"
    local tmux_env="${TMUX:-}"
    local declared_socket="${tmux_env%%,*}"
    local socket_dir="${declared_socket%/*}"
    local ancestors server_pid candidate

    [[ -n "$tmux_env" && -n "$declared_socket" ]] || return 1
    ancestors=" $(codex_yolo_process_ancestors "$start_pid" | tr '\n' ' ') "

    server_pid="$(command tmux -S "$declared_socket" display-message -p '#{pid}' 2>/dev/null)" || true
    if [[ -n "$server_pid" && "$ancestors" == *" $server_pid "* ]]; then
        printf '%s\n' "$declared_socket"
        return 0
    fi

    if [[ -d "$socket_dir" ]]; then
        for candidate in "$socket_dir"/*; do
            [[ -S "$candidate" && "$candidate" != "$declared_socket" ]] || continue
            server_pid="$(command tmux -S "$candidate" display-message -p '#{pid}' 2>/dev/null)" || continue
            if [[ -n "$server_pid" && "$ancestors" == *" $server_pid "* ]]; then
                printf '%s\n' "$candidate"
                return 0
            fi
        done
    fi

    # Preserve normal tmux behavior if process inspection is unavailable.
    printf '%s\n' "$declared_socket"
}

codex_yolo_init_tmux_socket() {
    local start_pid="${1:-$BASHPID}"
    local tmux_env="${TMUX:-}"
    local declared_socket="${tmux_env%%,*}"
    local server_pid session_id

    [[ -n "$tmux_env" ]] || return 0
    CODEX_YOLO_TMUX_SOCKET="$(codex_yolo_detect_tmux_socket "$start_pid")" || true
    [[ -n "$CODEX_YOLO_TMUX_SOCKET" ]] || return 0
    if [[ "$CODEX_YOLO_TMUX_SOCKET" != "$declared_socket" ]]; then
        log_info "Reusing owning tmux server socket: ${CODEX_YOLO_TMUX_SOCKET##*/} (TMUX reported ${declared_socket##*/})"
    fi

    # Detached helpers inherit TMUX and invoke tmux directly, so repair the
    # environment as well as routing launcher commands through tmux_run.
    server_pid="$(command tmux -S "$CODEX_YOLO_TMUX_SOCKET" \
        display-message -p '#{pid}' 2>/dev/null)" || server_pid=""
    session_id="${TMUX##*,}"
    if [[ -n "${TMUX_PANE:-}" ]]; then
        local detected_session_id
        detected_session_id="$(command tmux -S "$CODEX_YOLO_TMUX_SOCKET" \
            display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null)" || detected_session_id=""
        [[ -z "$detected_session_id" ]] || session_id="${detected_session_id#\$}"
    fi
    if [[ -n "$server_pid" ]]; then
        TMUX="$CODEX_YOLO_TMUX_SOCKET,$server_pid,$session_id"
        export TMUX
    fi
    export CODEX_YOLO_TMUX_SOCKET
}

# Run tmux against the resolved server rather than allowing a default-socket
# fallback.
tmux_run() {
    local socket_path="${CODEX_YOLO_TMUX_SOCKET:-}"

    if [[ -z "$socket_path" && -n "${TMUX:-}" ]]; then
        socket_path="${TMUX%%,*}"
    fi

    if [[ -n "$socket_path" ]]; then
        command tmux -S "$socket_path" "$@"
    else
        command tmux "$@"
    fi
}

# Resolve the tmux client displaying the session that owns the invoking pane.
# tmux normally infers this for switch-client, but command clients connected to
# a named server can report "no current client" even while the pane is attached.
tmux_current_client() {
    local source_session=""
    local activity client
    local best_activity=-1 best_client=""

    if [[ -n "${TMUX_PANE:-}" ]]; then
        source_session="$(tmux_run display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null)" || true
    fi

    # TMUX's final field is the numeric ID of the session that created the
    # pane environment. Use it when TMUX_PANE is unavailable or stale.
    if [[ -z "$source_session" ]]; then
        local source_session_id="${TMUX##*,}"
        if [[ "$source_session_id" =~ ^[0-9]+$ ]]; then
            source_session="\$$source_session_id"
        fi
    fi

    [[ -n "$source_session" ]] || return 1

    while IFS='|' read -r activity client; do
        [[ -n "$client" ]] || continue
        [[ "$activity" =~ ^[0-9]+$ ]] || activity=0
        if (( activity > best_activity )); then
            best_activity="$activity"
            best_client="$client"
        fi
    done < <(tmux_run list-clients -t "$source_session" \
        -F '#{client_activity}|#{client_name}' 2>/dev/null)

    [[ -n "$best_client" ]] || return 1
    printf '%s\n' "$best_client"
}

# Attach or switch to a tmux session, handling nested tmux correctly.
tmux_attach() {
    local target="$1"
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux — switch the current client to the new session
        local current_client=""
        current_client="$(tmux_current_client)" || true
        if [[ -n "$current_client" ]]; then
            tmux_run switch-client -c "$current_client" -t "$target"
        else
            tmux_run switch-client -t "$target"
        fi
    else
        tmux_run attach -t "$target"
    fi
}

codex_yolo_should_reconcile_auto_review() {
    local worktree_mode="$1" task_count="$2" first_task="$3"

    [[ "$worktree_mode" == "0" ]] || return 1
    [[ "$task_count" == "1" ]] || return 1
    [[ -z "$first_task" ]] || return 1
    [[ "${CODEX_YOLO_PERMISSION_PROFILE:-}" == "codex-auto-review" ]]
}

codex_yolo_start_auto_review_reconciliation() {
    local script_dir="$1" session="$2" audit_log="$3"
    local startup_delay="${CODEX_YOLO_AUTO_REVIEW_STARTUP_DELAY:-1}"

    log_info "Reconciling Codex Auto-review permissions in TUI"
    (
        sleep "$startup_delay" 2>/dev/null || true
        bash "$script_dir/lib/control-pane.sh" "$session" "$audit_log" auto-review-once
    ) >/dev/null 2>&1 &
    disown
}

codex_yolo_inject_control_command() {
    local script_dir="$1" session="$2" audit_log="$3" command="$4"
    local await_auto_review="${5:-0}"

    log_info "Injecting control command: ${command:0:60}${command:60:+...}"
    (
        export CODEX_YOLO_INJECT_AWAIT_AUTO_REVIEW="$await_auto_review"
        bash "$script_dir/lib/control-pane.sh" "$session" "$audit_log" inject-once "$command"
    ) >/dev/null 2>&1 &
    disown
}

main() {
    local session_name="" work_dir="" model="" effort="ultra" poll_interval="0.3" resume=0 prompt_file=""
    local effort_explicit=0
    local compatible_effort=""
    local worktree_mode=0 base_branch="" no_merge=0 no_cleanup=0 conflict_poll="5"
    local codex_sandbox_policy="${CODEX_YOLO_CODEX_SANDBOX:-auto}"
    local codex_permissions_policy="${CODEX_YOLO_PERMISSIONS:-auto}"
    local control_command=""
    local tasks=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--session)  session_name="$2"; shift 2 ;;
            -d|--dir)      work_dir="$2"; shift 2 ;;
            -m|--model)    model="$2"; shift 2 ;;
            -e|--effort)   effort="$2"; effort_explicit=1; shift 2 ;;
            -p|--poll)     poll_interval="$2"; shift 2 ;;
            -f|--file)     prompt_file="$2"; shift 2 ;;
            -c|--command)
                if [[ -n "$control_command" ]]; then
                    log_error "Only one -c/--command may be given; compose multiple commands via /queue [...]"
                    exit 1
                fi
                control_command="$2"
                shift 2
                ;;
            -w|--worktree)     worktree_mode=1; shift ;;
            --base-branch)     base_branch="$2"; shift 2 ;;
            --no-merge)        no_merge=1; shift ;;
            --no-cleanup)      no_cleanup=1; shift ;;
            --conflict-poll)   conflict_poll="$2"; shift 2 ;;
            --permissions)          codex_permissions_policy="$2"; shift 2 ;;
            --network)              CODEX_YOLO_NETWORK_ACCESS=1; shift ;;
            --no-network)           CODEX_YOLO_NETWORK_ACCESS=0; shift ;;
            --no-codex-sandbox)    codex_sandbox_policy="off"; shift ;;
            --force-codex-sandbox) codex_sandbox_policy="force"; shift ;;
            -r|--resume)   resume=1; shift ;;
            -h|--help)     usage; exit 0 ;;
            -*)            log_error "Unknown option: $1"; usage; exit 1 ;;
            *)          tasks+=("$1"); shift ;;
        esac
    done

    codex_yolo_init_tmux_socket

    # Validate -c/--command
    if [[ -n "$control_command" ]]; then
        if [[ "${control_command:0:1}" != "/" ]]; then
            log_error "-c/--command must start with '/' (got: ${control_command:0:40})"
            exit 1
        fi
    fi

    # Check prerequisites
    check_prereqs || exit 1

    # Validate -e/--effort ('none' leaves Codex's configured default).
    # Unknown levels are rejected by the API, so fail before starting a session.
    if [[ "$effort" == "none" ]]; then
        effort=""
    elif [[ -n "$effort" ]]; then
        case "$effort" in
            minimal|low|medium|high|xhigh|max|ultra) ;;
            *)
                log_error "Unknown effort level: $effort (expected minimal|low|medium|high|xhigh|max|ultra, or none)"
                exit 1
                ;;
        esac
    fi

    # Validate an explicitly selected model/effort pair before worktree setup
    # or any other stateful launch work. A default Ultra request may be capped
    # for a known older model, but an explicit -e choice is never rewritten.
    if [[ -n "$model" && -n "$effort" ]]; then
        compatible_effort="$(codex_yolo_compatible_effort "$model" "$effort")"
        if [[ "$compatible_effort" != "$effort" ]]; then
            if (( effort_explicit )); then
                log_error "$model does not support reasoning effort '$effort' (use '$compatible_effort')"
                exit 1
            fi
            log_warn "$model does not support the default '$effort' effort; using '$compatible_effort'"
            effort="$compatible_effort"
        fi
    fi

    # Handle --resume
    if (( resume )); then
        local existing
        existing="$(tmux_run list-sessions -F '#{session_name}' 2>/dev/null | grep '^codex-yolo-' | head -1)" || true
        if [[ -z "$existing" ]]; then
            log_error "No existing yolo session found"
            exit 1
        fi
        log_info "Re-attaching to session: $existing"
        if [[ -n "$control_command" ]]; then
            local resumed_audit_log="$(log_dir)/codex-yolo-${existing}.log"
            codex_yolo_inject_control_command "$SCRIPT_DIR" "$existing" "$resumed_audit_log" "$control_command"
        fi
        tmux_attach "$existing"
        exit $?
    fi

    # Read prompt from file if --file was given
    if [[ -n "$prompt_file" ]]; then
        if [[ ! -f "$prompt_file" ]]; then
            log_error "File not found: $prompt_file"
            exit 1
        fi
        local file_content
        file_content="$(cat "$prompt_file")"
        if [[ -z "$file_content" ]]; then
            log_error "File is empty: $prompt_file"
            exit 1
        fi
        tasks+=("$file_content")
    fi

    # No tasks = launch a single interactive codex session
    if [[ ${#tasks[@]} -eq 0 ]]; then
        tasks+=("")
    fi

    # Set defaults
    SESSION_NAME="${session_name:-codex-yolo-$(date '+%H%M%S')}"
    AUDIT_LOG="$(log_dir)/codex-yolo-${SESSION_NAME}.log"
    work_dir="${work_dir:-$(pwd)}"

    # Validate work_dir
    if [[ ! -d "$work_dir" ]]; then
        log_error "Working directory does not exist: $work_dir"
        exit 1
    fi

    # Resolve to absolute path
    work_dir="$(cd "$work_dir" && pwd)"

    # Ensure Codex CLI config directory exists
    ensure_codex_config
    configure_codex_sandbox "$codex_sandbox_policy" || exit 1
    configure_codex_permissions "$codex_permissions_policy" || exit 1
    export CODEX_YOLO_NETWORK_ACCESS

    # ── worktree validation ──────────────────────────────────────────────────
    if (( worktree_mode )); then
        source "$SCRIPT_DIR/lib/worktree-manager.sh"

        wt_validate_repo "$work_dir" || exit 1

        if ! check_git_merge_tree; then
            log_error "git 2.38+ required for merge-tree --write-tree (found: $(git version))"
            exit 1
        fi

        if [[ ${#tasks[@]} -lt 2 ]]; then
            log_error "Worktree mode requires at least 2 tasks"
            exit 1
        fi

        base_branch="${base_branch:-$(wt_current_branch "$work_dir")}"
    fi

    # No -m/--model given: pick the best model the account can actually use
    # (Astra → Sol → Terra → Luna → GPT-5.5, probed and cached — see
    # common.sh). Runs after every cheap validation so bad invocations fail
    # fast instead of paying a model probe first.
    if [[ -z "$model" ]]; then
        model="$(resolve_best_model)"
        if [[ -n "$model" ]]; then
            log_info "Auto-selected model: $model (override with -m/--model)"
        fi
    fi

    # Ultra is the normal default. Keep non-Ultra fallback models usable at
    # their supported maximum after automatic model selection.
    if [[ -n "$model" && -n "$effort" ]]; then
        compatible_effort="$(codex_yolo_compatible_effort "$model" "$effort")"
        if [[ "$compatible_effort" != "$effort" ]]; then
            if (( effort_explicit )); then
                log_error "$model does not support reasoning effort '$effort' (use '$compatible_effort')"
                exit 1
            fi
            log_warn "$model does not support the default '$effort' effort; using '$compatible_effort'"
            effort="$compatible_effort"
        fi
    elif [[ -z "$model" && "$effort" == "ultra" ]] && (( ! effort_explicit )); then
        # If every availability probe failed (including when offline), neither
        # the model nor its effort capabilities are known. Avoid forcing an
        # override that could make the configured fallback model reject launch.
        log_warn "Could not verify an Ultra-capable model; using Codex's configured model and effort"
        effort=""
    fi

    # ── worktree creation ────────────────────────────────────────────────────
    # Resolve model/effort compatibility before creating persistent worktrees,
    # so an invalid explicit pair cannot leave partially initialized state.
    if (( worktree_mode )); then
        log_info "Creating ${#tasks[@]} worktrees from branch: $base_branch"
        wt_create_all "$work_dir" "$SESSION_NAME" "$base_branch" "${#tasks[@]}" || exit 1
    fi

    # Truncate audit log for this run
    : > "$AUDIT_LOG"

    # Per-session marker directory for the PermissionRequest hook (see
    # codex_yolo_configure_permission_hook in common.sh): each TUI agent pane
    # is launched with CODEX_YOLO_WAITING_DIR in its environment, so approval
    # dialogs leave per-pane markers the approver daemon uses to recognize
    # dialogs rendered off-screen. Cleared per run so stale markers from a
    # previous session with the same name can never trigger keys.
    local waiting_dir="${AUDIT_LOG}.waiting"
    if mkdir -p "$waiting_dir" 2>/dev/null; then
        rm -f "$waiting_dir"/* 2>/dev/null || true
    else
        waiting_dir=""
        log_warn "Could not create marker dir ${AUDIT_LOG}.waiting; off-screen prompt detection disabled"
    fi

    log_info "Creating tmux session: $SESSION_NAME"
    log_info "Working directory: $work_dir"
    log_info "Tasks: ${#tasks[@]}"

    # Create detached tmux session with first agent window
    local first_task="${tasks[0]}"
    local agent_dir="$work_dir"
    local cmd

    if (( worktree_mode )); then
        agent_dir="$(wt_path_for "$SESSION_NAME" 1)"
    fi

    if (( worktree_mode )); then
        cmd="$(build_exec_agent_cmd "$model" "$first_task" "$effort")"
    else
        cmd="$(build_agent_cmd "$model" "$first_task" "$effort" "$waiting_dir")"
    fi
    if (( worktree_mode )); then
        cmd="$cmd ; touch '$(wt_done_marker "$SESSION_NAME" 1)'"
    fi

    tmux_run new-session -d -s "$SESSION_NAME" -n "agent-1" -c "$agent_dir"
    tmux_run send-keys -t "$SESSION_NAME:agent-1" "$cmd" C-m

    log_info "Started agent-1: ${first_task:+${first_task:0:60}...}${first_task:-interactive}"

    local auto_review_pending=0
    if codex_yolo_should_reconcile_auto_review "$worktree_mode" "${#tasks[@]}" "$first_task"; then
        codex_yolo_start_auto_review_reconciliation "$SCRIPT_DIR" "$SESSION_NAME" "$AUDIT_LOG"
        auto_review_pending=1
    fi

    # Create additional agent windows
    local i
    for (( i=1; i<${#tasks[@]}; i++ )); do
        local win_name="agent-$((i+1))"
        local task="${tasks[$i]}"
        agent_dir="$work_dir"

        if (( worktree_mode )); then
            agent_dir="$(wt_path_for "$SESSION_NAME" $((i+1)))"
        fi

        if (( worktree_mode )); then
            cmd="$(build_exec_agent_cmd "$model" "$task" "$effort")"
        else
            cmd="$(build_agent_cmd "$model" "$task" "$effort" "$waiting_dir")"
        fi
        if (( worktree_mode )); then
            cmd="$cmd ; touch '$(wt_done_marker "$SESSION_NAME" $((i+1)))'"
        fi

        tmux_run new-window -t "$SESSION_NAME" -n "$win_name" -c "$agent_dir"
        tmux_run send-keys -t "$SESSION_NAME:$win_name" "$cmd" C-m

        log_info "Started $win_name: ${task:+${task:0:60}...}${task:-interactive}"
    done

    # Start approver daemon in background (fully detached from this process).
    # The daemon self-terminates when the tmux session is gone.
    log_info "Starting approver daemon (poll=${poll_interval}s)"
    nohup bash "$SCRIPT_DIR/lib/approver-daemon.sh" "$SESSION_NAME" "$poll_interval" "$AUDIT_LOG" \
        >/dev/null 2>&1 &
    disown

    # ── worktree daemons ─────────────────────────────────────────────────────
    if (( worktree_mode )); then
        log_info "Starting conflict daemon (poll=${conflict_poll}s)"
        nohup bash "$SCRIPT_DIR/lib/conflict-daemon.sh" "$SESSION_NAME" "$conflict_poll" "$AUDIT_LOG" \
            >/dev/null 2>&1 &
        disown

        if (( ! no_merge )); then
            local merge_opts=""
            (( no_cleanup )) && merge_opts="$merge_opts --no-cleanup"
            [[ -n "$model" ]] && merge_opts="$merge_opts --model $model"
            [[ -n "$effort" ]] && merge_opts="$merge_opts --effort $effort"
            [[ -n "${CODEX_YOLO_PERMISSION_PROFILE:-}" ]] && merge_opts="$merge_opts --permissions '$CODEX_YOLO_PERMISSION_PROFILE'"
            if [[ "$(codex_yolo_network_access_value)" == "true" ]]; then
                merge_opts="$merge_opts --network"
            else
                merge_opts="$merge_opts --no-network"
            fi
            (( CODEX_YOLO_BYPASS_CODEX_SANDBOX )) && merge_opts="$merge_opts --no-codex-sandbox"
            if [[ -n "${CODEX_YOLO_FAKE_BWRAP_DIR:-}" ]]; then
                local fake_bwrap_dir="${CODEX_YOLO_FAKE_BWRAP_DIR//\'/\'\\\'\'}"
                merge_opts="$merge_opts --fake-bwrap-dir '$fake_bwrap_dir'"
            fi

            tmux_run new-window -t "$SESSION_NAME" -n "merge" -c "$work_dir"
            tmux_run send-keys -t "$SESSION_NAME:merge" \
                "bash '$SCRIPT_DIR/lib/merge-resolver.sh' '$SESSION_NAME' '$AUDIT_LOG' $merge_opts" C-m
        fi
    fi

    # Create control window with audit log tailing and slash commands
    tmux_run new-window -t "$SESSION_NAME" -n "control" -c "$work_dir"
    local control_mode="standard"
    (( worktree_mode )) && control_mode="worktree"
    local control_script="${SCRIPT_DIR//\'/\'\\\'\'}"
    local control_session="${SESSION_NAME//\'/\'\\\'\'}"
    local control_log="${AUDIT_LOG//\'/\'\\\'\'}"
    tmux_run send-keys -t "$SESSION_NAME:control" \
        "bash '$control_script/lib/control-pane.sh' '$control_session' '$control_log' '$control_mode'" C-m

    # Inject one-shot control command if requested. When auto-review reconciliation
    # is also in flight, gate the injection on its completion so the first /loop or
    # /plan keystrokes don't land on the Codex welcome / permissions screen.
    if [[ -n "$control_command" ]]; then
        codex_yolo_inject_control_command \
            "$SCRIPT_DIR" "$SESSION_NAME" "$AUDIT_LOG" "$control_command" "$auto_review_pending"
    fi

    # Select the first agent window
    tmux_run select-window -t "$SESSION_NAME:agent-1"

    log_info "Attaching to session (Ctrl-b n/p to switch windows, Ctrl-b d to detach)"
    log_info "Audit log: $AUDIT_LOG"

    # Attach (or switch if already inside tmux)
    tmux_attach "$SESSION_NAME"
}

build_agent_cmd() {
    local model="$1" task="$2" effort="${3:-}" waiting_dir="${4:-}"
    local cmd
    local prefix
    local permission_arg
    local effort_arg

    prefix="$(codex_yolo_command_prefix)"
    permission_arg="$(codex_yolo_permission_config_arg)"
    effort_arg="$(codex_yolo_effort_config_arg "$effort")"

    # Marker dir for the PermissionRequest hook, passed via the pane
    # environment (the hook command is static — see common.sh). Optional:
    # without it the daemon simply has no off-screen prompt markers.
    if [[ -n "$waiting_dir" ]]; then
        local escaped_waiting="${waiting_dir//\'/\'\\\'\'}"
        prefix="CODEX_YOLO_WAITING_DIR='$escaped_waiting' $prefix"
    fi

    if (( CODEX_YOLO_FORCE_CODEX_SANDBOX )); then
        if (( ${CODEX_YOLO_ASK_FOR_APPROVAL:-0} )); then
            cmd="${prefix}codex $permission_arg"
        else
    if [[ -n "$permission_arg" ]]; then
      # Permission profiles and legacy --sandbox settings do not compose.
      cmd="${prefix}codex $permission_arg"
    else
      cmd="${prefix}codex --sandbox workspace-write"
    fi
        fi
    elif (( CODEX_YOLO_BYPASS_CODEX_SANDBOX )); then
        cmd="${prefix}codex --dangerously-bypass-approvals-and-sandbox $permission_arg"
    elif (( ${CODEX_YOLO_ASK_FOR_APPROVAL:-0} )); then
        cmd="${prefix}codex $permission_arg"
    else
    if [[ -n "$permission_arg" ]]; then
      # Permission profiles and legacy --sandbox settings do not compose.
      cmd="${prefix}codex $permission_arg"
    else
      cmd="${prefix}codex --sandbox workspace-write"
    fi
    fi
    cmd="${cmd%" "}"

    if [[ -n "$model" ]]; then
        cmd="$cmd --model $model"
    fi

    if [[ -n "$effort_arg" ]]; then
        cmd="$cmd ${effort_arg%" "}"
    fi

    # No task = interactive mode
    if [[ -z "$task" ]]; then
        echo "$cmd"
        return
    fi

    # For multiline prompts, write to a temp file and pipe into codex.
    # This avoids shell quoting issues with tmux send-keys.
    if [[ "$task" == *$'\n'* ]]; then
        local tmpfile
        tmpfile="/tmp/codex-yolo-prompt-$RANDOM$RANDOM.txt"
        printf '%s' "$task" > "$tmpfile"
        echo "cat '$tmpfile' | $cmd"
        return
    fi

    # Escape single quotes in the task for shell safety
    local escaped_task="${task//\'/\'\\\'\'}"
    cmd="$cmd '$escaped_task'"

    echo "$cmd"
}

build_exec_agent_cmd() {
    local model="$1" task="$2" effort="${3:-}"
    local cmd
    local effort_arg
  local permission_arg
  permission_arg="$(codex_yolo_permission_config_arg)"
  if (( ${CODEX_YOLO_ASK_FOR_APPROVAL:-0} )) && [[ -n "$permission_arg" ]]; then
    cmd="$(codex_yolo_command_prefix)codex ${permission_arg%" "} exec"
  elif [[ -n "$permission_arg" ]]; then
    cmd="$(codex_yolo_command_prefix)codex exec $permission_arg"
  else
    cmd="$(codex_yolo_command_prefix)codex exec --sandbox workspace-write"
  fi
    cmd="${cmd%" "}"

    if (( CODEX_YOLO_BYPASS_CODEX_SANDBOX )); then
        cmd="$cmd --dangerously-bypass-approvals-and-sandbox"
    fi

    if [[ -n "$model" ]]; then
        cmd="$cmd --model $model"
    fi

    effort_arg="$(codex_yolo_effort_config_arg "$effort")"
    if [[ -n "$effort_arg" ]]; then
        cmd="$cmd ${effort_arg%" "}"
    fi

    if [[ "$task" == *$'\n'* ]]; then
        local tmpfile
        tmpfile="/tmp/codex-yolo-prompt-$RANDOM$RANDOM.txt"
        printf '%s' "$task" > "$tmpfile"
        echo "cat '$tmpfile' | $cmd -"
        return
    fi

    local escaped_task="${task//\'/\'\\\'\'}"
    cmd="$cmd '$escaped_task'"

    echo "$cmd"
}

main "$@"
